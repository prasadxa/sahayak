# Get your Convex deployment URL here: https://docs.convex.dev/quickstart/nextjs
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# CallMissed API key (cm_...) — powers chat, embeddings, STT, TTS, web search.
# Set this in BOTH places:
#   1. .env.local for the Next.js server (route handlers)
#   2. `npx convex env set CALLMISSED_API_KEY cm_...` for Convex functions
#      (knowledge-base ingestion, voice STT/TTS run as Convex actions)
CALLMISSED_API_KEY=

# Optional model overrides (defaults are free-tier CallMissed models)
# CALLMISSED_MODEL_SMALL=sarvam-105b-conversations
# CALLMISSED_MODEL_LARGE=sarvam-105b
# CALLMISSED_MODEL_REASONING=kimi-k2.6
# CALLMISSED_MODEL_TITLE=glm-4.7-flash
# CALLMISSED_MODEL_EMBEDDING=text-embedding-3-small
# CALLMISSED_MODEL_STT=saaras:v3
# CALLMISSED_MODEL_TTS=bulbul:v3
# CALLMISSED_TTS_VOICE=shubh

# Optional: Google OAuth (email/password auth works without it)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional: enables resumable chat streams
REDIS_URL=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public base URL printed in kiosk receipt QR codes (/track?ref=...).
# Set this when the kiosk runs on localhost so phones can open the link,
# e.g. https://sahayak.example.com
# NEXT_PUBLIC_TRACK_BASE_URL=

# Raspberry Pi kiosk only (read by hardware/pi/kiosk-launch.sh, not Next.js)
# KIOSK_URL=http://localhost:3000/kiosk

# Convex env (set with `npx convex env set`, not here):
#   ADMIN_EMAILS=you@example.com,other@example.com   → admin role
